# Copy to .env and set real values

# Local example:
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/realestate
# Railway Postgres also works with its default DATABASE_URL / postgres:// URL.

# Needed for later modules (bot/mini app)
BOT_TOKEN=123456:ABCDEF

# Admin panel
ADMIN_PANEL_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
ADMIN_SESSION_SECRET=change_me_long_random_secret
ADMIN_WEB_HOST=127.0.0.1
ADMIN_WEB_PORT=8000

# OLX base URL (from your requirement)
OLX_BASE_URL=https://www.olx.uz
OLX_PROXY_SERVER=
OLX_PROXY_USERNAME=
OLX_PROXY_PASSWORD=

# Telegram Mini App URL (public HTTPS)s sa
MINI_APP_URL=https://khurshidmurotov.github.io/Real-Estate-Scanner/

